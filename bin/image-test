#!/usr/bin/env bash
# The image test. The image job of CI (build.yaml) runs it on the image that
# it built, before any push: a failed test means no image.
#
# Usage: bin/image-test <image ref>
#
# It runs tests/test_bridge.py in container mode: two containers of the
# image with a read-only root file system, a mock upstream and a model
# gateway, on a Docker network of their own. The values are fake. In CI
# only: never on a workstation that runs a live cluster in Docker. On a
# workstation, `cd tests && python3 -m unittest -v test_bridge` runs the
# same tests on the source, with processes on the loopback address.
set -euo pipefail

image="${1:?usage: bin/image-test <image ref>}"
repo="$(cd "$(dirname "$0")/.." && pwd)"

if [[ "${CI:-}" != "true" ]]; then
  echo "bin/image-test: the image test runs in CI only" >&2
  exit 1
fi

export IMAGE_REF="$image"
export PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
cd "$repo/tests"
python3 -m unittest -v test_bridge
