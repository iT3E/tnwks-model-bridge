# editorconfig.org (tnwks-ops' .editorconfig, plus Node)
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true


[Makefile]
indent_style = tab

[*.{bash,sh}]
indent_style = space
indent_size = 4

[bin/*]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
